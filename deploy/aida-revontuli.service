[Unit]
Description=AIDA standalone lens calibration service
After=network-online.target
[Service]
WorkingDirectory=/home/j/src/widefield-star-calibrator
Environment=AIDA_TEST_CASE_DIR=/mnt/data/juha/gaia/aida
ExecStart=/usr/bin/node /home/j/src/widefield-star-calibrator/tools/serve_calibrator.js --host 127.0.0.1 --port 18790 --test-case-dir /mnt/data/juha/gaia/aida
Restart=on-failure
RestartSec=5
[Install]
WantedBy=default.target
