[Unit]
Description=GAIA auroral image data center
After=network-online.target mnt-shovel.mount
Wants=network-online.target

[Service]
Type=simple
User=j
WorkingDirectory=/mnt/data/juha/gaia/code
Environment=RUST_LOG=gaia_datacenter=info,tower_http=info
Environment=GAIA_ARCHIVE_ROOT=/mnt/shovel/gaia
Environment=GAIA_DB_PATH=/home/j/var/gaia/gaia.sqlite3
Environment=GAIA_SOURCES=/mnt/data/juha/gaia/code/sources
Environment=GAIA_STATIC_DIR=/var/www/html/gaia
Environment=GAIA_LISTEN=127.0.0.1:8765
ExecStart=/mnt/data/juha/gaia/code/target/release/gaia-server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
